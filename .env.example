# Copy to .env for local use, or paste these into your Railway/Render dashboard.
# .env is gitignored — never commit real values.

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Must be false in production.
DEBUG=false

# Comma-separated. Railway/Render inject their own hostname automatically;
# add your custom domain here.
ALLOWED_HOSTS=erp.ipellx.ltd

# Optional. Defaults to https:// + each ALLOWED_HOSTS entry.
CSRF_TRUSTED_ORIGINS=https://erp.ipellx.ltd

# Postgres connection string. Without it the app falls back to local SQLite.
#
# Supabase gives you two. Use the transaction pooler on port 6543 for serverless
# or many short-lived processes; use the direct connection on 5432 for a normal
# long-running server, and always for `migrate`.
#   pooler: postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   direct: postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# Port 6543 auto-enables pooler-safe settings (no persistent connections, no
# server-side cursors). Set PGBOUNCER_MODE=true to force them on another port.
DATABASE_URL=
PGBOUNCER_MODE=false

# Uploaded files. Either a persistent disk path (MEDIA_ROOT) or Supabase Storage
# (all four SUPABASE_S3_* values). Supabase Storage wins when fully set.
MEDIA_ROOT=/var/data/media

# Supabase Dashboard > Storage > S3 Connection, then create an access key there.
SUPABASE_S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY=
SUPABASE_S3_SECRET_KEY=
SUPABASE_S3_BUCKET=erp-media

# SMTP for password reset. Leave EMAIL_HOST blank to print emails to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@ipellx.ltd

# WhatsApp Business Cloud API, for the "Notify Supplier" button on
# purchase orders. Leave blank to leave that button showing a clear
# "not configured" message instead of silently doing nothing. See
# WHATSAPP_SETUP.md for how to get these three values.
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=purchase_order_alert
