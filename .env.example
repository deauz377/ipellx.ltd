# Copy to .env for local use, or paste these into your Railway/Render dashboard.
# .env is gitignored — never commit real values.

# Required in production. Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Must be false in production.
DEBUG=false

# Comma-separated. Railway/Render inject their own hostname automatically;
# add your custom domain here.
ALLOWED_HOSTS=erp.ipellx.ltd

# Optional. Defaults to https:// + each ALLOWED_HOSTS entry.
CSRF_TRUSTED_ORIGINS=https://erp.ipellx.ltd

# Postgres connection string. Provided automatically by Railway/Render when you
# attach a database. Without it the app falls back to local SQLite.
DATABASE_URL=

# Absolute path to the mounted persistent disk for uploaded files.
MEDIA_ROOT=/var/data/media

# SMTP for password reset. Leave EMAIL_HOST blank to print emails to the log.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@ipellx.ltd
