{"buildCommand":"pip install -r requirements.txt && python manage.py migrate",
  "framework": null,
  "functions": {
    "api/index.py": {
      "includeFiles": "**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/cron/send-payment-reminders/", "schedule": "0 7 * * *" }
  ]
}
