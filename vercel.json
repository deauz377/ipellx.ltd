{
  "version": 2,
  "builds": [
    {
      "src": "build_files.sh",
      "use": "@vercel/static-build",
      "config": { "distDir": "14xlERP_System/staticfiles" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    { "src": "/static/(.*)", "dest": "/14xlERP_System/staticfiles/$1" },
    { "src": "/(.*)", "dest": "/api/index.py" }
  ]
}
