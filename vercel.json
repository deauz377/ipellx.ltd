{
  "buildCommand": "pip install --break-system-packages -r requirements.txt && python3 scripts/prune_vendor.py",
  "framework": null,
  "outputDirectory": ".",
  "functions": {
    "api/index.py": {
      "includeFiles": "**"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ],
  "crons": [
    { "path": "/cron/send-payment-reminders/", "schedule": "0 7 * * *" }
  ]
}
